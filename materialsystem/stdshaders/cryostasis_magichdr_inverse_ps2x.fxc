// STATIC: "APPROX_SRGB_ADAPTER"	"0..1" [ps20b] [PC]

#define HDRTYPE HDR_TYPE_NONE
#include "common_ps_fxc.h"

#ifndef APPROX_SRGB_ADAPTER
#define APPROX_SRGB_ADAPTER 0
#endif

sampler BaseTextureSampler : register( s0 );

float4 CryostasisMagicHDRParams : register( c0 ); // x bloom brightness multiplier, y bloom saturation

struct PS_INPUT
{
	float2 baseTexCoord : TEXCOORD0;
};

float3 CryostasisApplySaturation( float3 color, float saturation )
{
	const float3 lumCoeff = float3( 0.2126f, 0.7152f, 0.0722f );
	float luma = dot( lumCoeff, color );
	return lerp( luma.xxx, color, saturation );
}

float3 CryostasisReinhardInverse( float3 color )
{
	return -( color / min( color - 1.0f, -0.1f ) );
}

float3 CryostasisApproxLinearToGamma( float3 color )
{
	color = max( color, 0.00001f );
	return color * rsqrt( color );
}

float4 main( PS_INPUT i ) : COLOR
{
	float4 color = tex2D( BaseTextureSampler, i.baseTexCoord );

	#if ( APPROX_SRGB_ADAPTER == 1 )
	{
		color.rgb = CryostasisApproxLinearToGamma( color.rgb );
	}
	#endif

	float saturation = CryostasisMagicHDRParams.y > 1.0f
		? pow( abs( CryostasisMagicHDRParams.y ), 2.0f )
		: CryostasisMagicHDRParams.y;

	color.rgb = saturate( CryostasisApplySaturation( color.rgb, saturation ) );
	color.rgb = CryostasisReinhardInverse( color.rgb );
	color.rgb *= CryostasisMagicHDRParams.x;

	#if ( APPROX_SRGB_ADAPTER == 1 )
	{
		color.rgb *= color.rgb;
	}
	#endif

	return float4( max( color.rgb, 0.0f ), 1.0f );
}
